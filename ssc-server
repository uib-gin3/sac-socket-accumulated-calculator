#!/usr/bin/env python3

from math import sqrt
from statistics import mean, stdev

import socketserver

class ThreadedTCPServer(socketserver.ThreadingMixIn, socketserver.TCPServer):
    daemon_threads = True
    allow_reuse_address = True


class SacSockCalHandler(socketserver.StreamRequestHandler):
    def handle(self):
        self.wfile.write("GREETINGS PROFESSOR FALKEN.\n".encode('utf-8'))

        mem = []
        while True:

            received = self.rfile.readline()
    
            try:
                number = int(received)
                print(f"Received number: {number}")
                mem.append(number)
                continue
            except ValueError:
                number = None

            try:
                operation = received.decode('utf-8').strip()
                print(f"Received operation: {operation}")
            except (UnicodeDecodeError, LookupError, ValueError, TypeError):
                operation = None
                print("Invalid data, ignoring")

 
            try:
                if operation == 'clear':
                    print(f"Clearing")
                    mem = [] 
                    result = ''

                elif operation == 'add':
                    print(f"Applying add to current memory: {mem}")
                    result = mem.pop(0) # FIFO
                    while len(mem):
                        item = mem.pop(0) 
                        result += item

                elif operation == 'sub':
                    print(f"Applying sub to current memory: {mem}")
                    result = mem.pop(0)
                    while len(mem):
                        item = mem.pop(0) 
                        result -= item

                elif operation == 'div':
                    result = mem.pop(0)
                    while len(mem):
                        item = mem.pop(0) 
                        result /= item

                elif operation == 'mult':
                    result = mem.pop(0)
                    while len(mem):
                        item = mem.pop(0) 
                        result *= item

                elif operation == 'sqrt':
                    if len(mem) == 1:
                        result = sqrt(mem.pop(0))
                        mem = []
                    else:
                        result = 'Error: More than one value'

                elif operation == 'mean':
                    if len(mem) > 1:
                        result = mean(mem)
                        mem = []
                    else:
                        result = 'Error: More than one needed'

                elif operation == 'std':
                    if len(mem) > 1:
                        result = stdev(mem)
                        mem = []
                    else:
                        result = 'Error: More than one needed'

                else:
                    result = "Error: Unknown operation"

            except IndexError:
                result = "Error: Missing value"

            if result and type(result) in (int, float):
                mem.append(result)

            print(f"Mem is {mem}")
            self.wfile.write(f"{result}\n".encode('utf-8'))


if __name__=='__main__':
    print("SAC sock calc")

    server = ThreadedTCPServer(('', 1234), SacSockCalHandler)

    try:
        server.serve_forever()
    except KeyboardInterrupt:
        pass

    server.server_close()
