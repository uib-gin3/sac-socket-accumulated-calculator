#!/usr/bin/env python3

# This file has been developed fully by hand without LLM intervention, is the fun part :)
#
# Based on the example: https://github.com/wisaaco/AA_DistributedSystems_Lab/blob/main/U1-Sockets/D_server_game.py
#
# Logging is possible by piping the output to a file or tee this avoid having
# to use python logging feature and makes this code cleaner.
#
# ./sac-server | tee sac-server.log
#

import re
import threading
import socketserver

from sys import argv
from math import sqrt
from statistics import mean, stdev


class ThreadedTCPServer(socketserver.ThreadingMixIn, socketserver.TCPServer):
    daemon_threads = True
    allow_reuse_address = True

    # Default response time window to 1000 which fits ~30s of the benchmark
    def __init__(self, server_address, RequestHandlerClass, stats=True,
                 response_time_window=1000, bind_and_activate=True):
        super().__init__(server_address, RequestHandlerClass, bind_and_activate)

        self.stats = stats
        if stats:
            self.connections = 0
            self.active_connections = 0
            self.bytes_in = 0
            self.bytes_out = 0
            self.operations = 0
            self.errors = 0 

            # We will keep an array of the last `response_time_window` response
            # times so we can do some stats.
            self.response_time_window = response_time_window
            self.response_times = []

            # We'll need some concurrency control to avoid messing up the stats
            # This WILL impact performance, that is why stats can be shutdown
            # with stats=False
            self.connections_lock = threading.Lock()

    def pretty_stats(self):
        return (
            f"active_connections: {self.active_connections}\n"
            f"connections: {self.active_connections}\n"
            f"bytes_in: {self.bytes_in}\n"
            f"bytes_out: {self.bytes_out}\n"
            f"operations: {self.operations}\n"
            f"errors: {self.errors}"
        )


class SacSockCalHandler(socketserver.StreamRequestHandler):


    def send_line(self, message, skip_stats=False):
        out = f"{message}\n".encode('utf-8')
        self.wfile.write(out)

        print(skip_stats)
        print(message)
        if self.server.stats and not skip_stats:
            with self.server.connections_lock:
                self.server.bytes_out += len(out)


    def handle(self):
        self.send_line("GREETINGS PROFESSOR FALKEN.", skip_stats=True)
        self.send_line("DO YOU WANT TO PLAY CALCULATIONS?", skip_stats=True)
        self.send_line("SEND NUMBERS (ONE PER LINE) OR AN OPERATION.", skip_stats=True)
        self.send_line("AVAILABLE OPERATIONS:", skip_stats=True)
        self.send_line("add, sub, div, mult, sqrt, mean, std, clear, stats, reset-stats quit", skip_stats=True)

        if self.server.stats:
            with self.server.connections_lock:
                self.server.connections += 1
                self.server.active_connections += 1

        mem = []
        while True:

            received = self.rfile.readline()

            if self.server.stats:
                with self.server.connections_lock:
                    self.server.bytes_in += len(received)

            try:
                # Get the user input with some sanitize
                raw = received.decode('utf-8').strip().lower()
                number = int(received)
                print(f"Received number: {number}")
                mem.append(number)
                continue
            except ValueError:
                number = None
            except (UnicodeDecodeError, LookupError, ValueError, TypeError):
                operation = None
                print("Invalid data, ignoring")

            operation = re.sub(r'[^a-z0-9.-]', '', raw)
            print(f"Received operation: {operation}")
 
            try:
                if operation == 'clear':
                    print(f"Clearing")
                    mem = [] 
                    result = ''

                elif operation == 'add':
                    print(f"Applying add to current memory: {mem}")
                    # Using FIFO queue to process because non-commutative
                    # operations would fail otherwise
                    result = mem.pop(0) 
                    while len(mem):
                        item = mem.pop(0) 
                        result += item

                elif operation == 'sub':
                    print(f"Applying sub to current memory: {mem}")
                    result = mem.pop(0)
                    while len(mem):
                        item = mem.pop(0) 
                        result -= item

                elif operation == 'div':
                    result = mem.pop(0)
                    while len(mem):
                        item = mem.pop(0) 
                        result /= item

                elif operation == 'mult':
                    result = mem.pop(0)
                    while len(mem):
                        item = mem.pop(0) 
                        result *= item

                elif operation == 'sqrt':
                    if len(mem) == 1:
                        result = sqrt(mem.pop(0))
                        mem = []
                    else:
                        result = 'Error: More than one value'

                elif operation == 'mean':
                    if len(mem) > 1:
                        result = mean(mem)
                        mem = []
                    else:
                        result = 'Error: More than one needed'

                elif operation == 'std':
                    if len(mem) > 1:
                        result = stdev(mem)
                        mem = []
                    else:
                        result = 'Error: More than one needed'

                elif operation == 'stats':
                    if self.server.stats:
                        # Avoid counting stats bytes
                        self.server.bytes_in -= len(received)

                        result = self.server.pretty_stats()
                    else:
                        result = 'Error: stats disabled'

                elif operation == 'reset-stats':
                    print("Resetting stats")
                    if self.server.stats:
                        self.server.bytes_in = 0
                        self.server.bytes_out = 0
                        self.server.operations = 0
                        self.server.errors = 0 
                        result = "Stats resetted"
                    else:
                        result = 'Error: stats disabled'

                elif operation == 'quit':
                    print("Client closed the connection")
                    if self.server.stats:
                        with self.server.connections_lock:
                            self.server.active_connections -= 1
                    break

                else:
                    result = "Error: Unknown operation"

            except IndexError:
                result = "Error: Missing value"
                if self.server.stats:
                    with self.server.connections_lock:
                        self.server.errors += 1

            except ArithmeticError as exc:
                result = f"Error: {exc}"
                if self.server.stats:
                    with self.server.connections_lock:
                        self.server.errors += 1

            # Just manipulate the memory if no error
            if result and type(result) in (int, float):
                if self.server.stats:
                    with self.server.connections_lock:
                        self.server.operations += 1
                mem.append(result)

            print(f"Mem is {mem}")
            try:
                skip_stats = operation == 'stats'
                self.send_line(result, skip_stats=skip_stats)
            except BrokenPipeError:
                print("Client disconnected")
                if self.server.stats:
                    with self.server.connections_lock:
                        self.server.active_connections -= 1
                break



if __name__=='__main__':

    # Kidna recursive acrynom following old unix traditions :)
    print("SAC socket accumulator calculator")

    # Yes would be faciner to use click but that way is simpler and dep-free
    stats = '--no-stats' not in argv


    # 1234 is a nice number for a port of a calculator, also a great password :D
    server = ThreadedTCPServer(('', 1234), SacSockCalHandler, stats=stats)

    try:
        server.serve_forever()
    except KeyboardInterrupt:
        pass

    server.server_close()
