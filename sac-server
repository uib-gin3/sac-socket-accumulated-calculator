import re
import time
import logging
import threading
import socketserver

from sys import argv
from math import sqrt

# Increases required python version to 3.8
# with --no-stats probably can run 3.6 or below
from statistics import mean, stdev, quantiles


logger = logging.getLogger(__name__)

class ThreadedTCPServer(socketserver.ThreadingMixIn, socketserver.TCPServer):
    daemon_threads = True
    allow_reuse_address = True

    # Default response time window to 1000 which fits ~30s of the benchmark
    def __init__(self, server_address, RequestHandlerClass, stats=True,
                 response_times_window=1000, bind_and_activate=True):
        super().__init__(server_address, RequestHandlerClass, bind_and_activate)

        self.stats = stats
        if stats:
            self.connections = 0
            self.active_connections = 0
            self.bytes_in = 0
            self.bytes_out = 0
            self.operations = 0
            self.errors = 0 

            # We will keep an array of the last `response_time_window` response
            # times so we can do some stats.
            self.response_times_window = response_times_window
            self.response_times = {}
            self.response_times_pos = 0

            # We'll need some concurrency control to avoid messing up the stats
            # This WILL impact performance, that is why stats can be shutdown
            # with stats=False
            self.connections_lock = threading.Lock()

    def pretty_stats(self):
        return (
            f"active_connections: {self.active_connections}\n"
            f"connections: {self.active_connections}\n"
            f"bytes_in: {self.bytes_in}\n"
            f"bytes_out: {self.bytes_out}\n"
            f"operations: {self.operations}\n"
            f"errors: {self.errors}"
        )


class SacSockCalHandler(socketserver.StreamRequestHandler):


    def send_line(self, message, skip_stats=False):
        out = f"{message}\n".encode('utf-8')

        self.wfile.write(out)
        size = len(out)

        if self.server.stats and not skip_stats:
            with self.server.connections_lock:
                self.server.bytes_out += size

        logger.debug(f"Send {size} bytes: '{message}'")
       

    def handle(self):
        self.send_line("GREETINGS PROFESSOR FALKEN.", skip_stats=True)
        self.send_line("DO YOU WANT TO PLAY CALCULATIONS?", skip_stats=True)
        self.send_line("SEND NUMBERS (ONE PER LINE) OR AN OPERATION.",
                       skip_stats=True)
        self.send_line("AVAILABLE OPERATIONS:", skip_stats=True)
        self.send_line("add, sub, div, mult, sqrt, mean, std, clear, " + 
                       "stats, reset-stats quit", skip_stats=True)

        if self.server.stats:
            with self.server.connections_lock:
                self.server.connections += 1
                self.server.active_connections += 1

        mem = []
        while True:

            received = self.rfile.readline()

            if self.server.stats:
                start_time = time.perf_counter()
                with self.server.connections_lock:
                    self.server.bytes_in += len(received)

            try:
                # Get the user input with some sanitize
                raw = received.decode('utf-8').strip().lower()
                number = int(received)
                logger.debug(f"Received number: {number}")
                mem.append(number)
                continue
            except ValueError:
                number = None
            except (UnicodeDecodeError, LookupError, ValueError, TypeError):
                logger.error("Invalid data, ignoring")
                logger.error(exc)
                operation = None

            operation = re.sub(r'[^a-z0-9.-]', '', raw)
            logger.debug(f"Received operation: {operation}")
 
            try:
                if operation == 'clear':
                    logger.debug(f"Clearing")
                    mem = [] 
                    result = ''

                elif operation == 'add':
                    logger.debug(f"Applying add to current memory: {mem}")
                    # Using FIFO queue to process because non-commutative
                    # operations would fail otherwise
                    # Would be possible to do more sophisticated thinghs
                    # like operation trees but this is a sockets assignement
                    # not data structures :)
                    result = mem.pop(0) 
                    while len(mem):
                        item = mem.pop(0) 
                        result += item

                elif operation == 'sub':
                    logger.debug(f"Applying sub to current memory: {mem}")
                    result = mem.pop(0)
                    while len(mem):
                        item = mem.pop(0) 
                        result -= item

                elif operation == 'div':
                    result = mem.pop(0)
                    while len(mem):
                        item = mem.pop(0) 
                        result /= item

                elif operation == 'mult':
                    result = mem.pop(0)
                    while len(mem):
                        item = mem.pop(0) 
                        result *= item

                elif operation == 'sqrt':
                    if len(mem) == 1:
                        result = sqrt(mem.pop(0))
                        mem = []
                    else:
                        result = 'Error: More than one value'

                elif operation == 'mean':
                    result = mean(mem)
                    mem = []

                elif operation == 'std':
                    if len(mem) > 1:
                        result = stdev(mem)
                        mem = []
                    else:
                        result = 'Error: More than one needed'

                elif operation == 'stats':
                    if self.server.stats:
                        # Avoid counting stats bytes
                        self.server.bytes_in -= len(received)

                        result = self.server.pretty_stats()
                    else:
                        result = 'Error: stats disabled'

                elif operation == 'reset-stats':
                    logger.debug("Resetting stats")
                    if self.server.stats:
                        self.server.bytes_in = 0
                        self.server.bytes_out = 0
                        self.server.operations = 0
                        self.server.errors = 0 
                        result = "Stats resetted"
                    else:
                        result = 'Error: stats disabled'

                elif operation == 'quit':
                    logger.debug("Client closed the connection")
                    if self.server.stats:
                        with self.server.connections_lock:
                            self.server.active_connections -= 1
                    break

                else:
                    result = "Error: Unknown operation"

            except IndexError:
                logger.error(exc)
                result = "Error: Missing value"
                if self.server.stats:
                    with self.server.connections_lock:
                        self.server.errors += 1

            except ArithmeticError as exc:
                logger.error(exc)
                result = f"Error: {exc}"
                if self.server.stats:
                    with self.server.connections_lock:
                        self.server.errors += 1

            # Just manipulate the memory if no error
            if result and type(result) in (int, float):
                if self.server.stats:
                    with self.server.connections_lock:
                        self.server.operations += 1
                mem.append(result)
            else:
                logger.debug(f"User error: '{result}'")

            logger.debug(f"Mem is {mem}")
            try:
                # Skip stats on stats command as it is a little different
                # and time consuming than others and we want to reduce heisenbug
                skip_stats = operation == 'stats'
                self.send_line(result, skip_stats=skip_stats)

                # Count also time to respond as response_time
                # not just calculation time that would be
                # taking the measure BEFORE the send_line
                if self.server.stats and not skip_stats:
                    response_time = time.perf_counter() - start_time

                    max_tw = self.server.response_times_window
                    with self.server.connections_lock:
                        # Using position as keys of the dict
                        # better than a list because is self initialized
                        pos = self.server.response_times_pos
                        self.server.response_times[pos] = response_time
                        self.server.response_times_pos = (pos + 1) % max_tw

                    response_times_list = self.server.response_times.values()
                    # Not always a good measuere but a common one
                    average = mean(response_times_list)
                    # p95 is more significant than the average when related to
                    # response times. Inclisve is importad while the sample is
                    # still small
                    p95 = quantiles(
                        response_times_list, n=100, method='inclusive')[94]

                    logger.debug(f"Responded in {response_time * 1000:.2f}ms")
                    logger.debug(f"avg: {average * 1000:.2f}ms")
                    logger.debug(f"p95: {p95 * 1000:.2f}ms")

            except BrokenPipeError:
                logger.debug("Client disconnected")
                if self.server.stats:
                    with self.server.connections_lock:
                        self.server.active_connections -= 1
                break



if __name__=='__main__':
    # Yes would be faciner to use click but that way is simpler and dep-free
    stats = '--no-stats' not in argv
    log_level = logging.DEBUG if '--debug' in argv else logging.INFO

    logging.basicConfig(
        level=log_level,
        format='%(asctime)s - %(levelname)s - %(message)s',
        datefmt='%Y-%m-%d %H:%M:%S'
    )

    # Kidna recursive acrynom following old unix traditions :)
    logger.info("SAC socket accumulated calculator")

    # 1234 is a nice number for a port of a calculator, also a great password :D
    server = ThreadedTCPServer(('', 1234), SacSockCalHandler, stats=stats)

    try:
        server.serve_forever()
    except KeyboardInterrupt:
        pass

    server.server_close()
    logger.info('Bye!')
